{{- $allowed := slice "about" "posts" "projects" "awards" "talks" "courses" -}}
{{- $items := slice -}}
{{- range .Site.Pages -}}
  {{- $section := .Section -}}
  {{- if and (in $allowed $section) (not .Draft) (not .Params.private) (not .Params.exclude_search) (ne .Kind "home") -}}
    {{- $authors := .Params.authors -}}
    {{- if not $authors -}}
      {{- with .Params.author -}}{{- $authors = slice . -}}{{- end -}}
    {{- end -}}
    {{- $projectNames := slice -}}
    {{- with .Params.projects -}}
      {{- range . -}}
        {{- $project := $.Site.GetPage (printf "projects/%s" .) -}}
        {{- if $project -}}
          {{- $projectNames = $projectNames | append $project.Title -}}
        {{- else -}}
          {{- $projectNames = $projectNames | append . -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $summary := .Params.summary | default .Params.abstract | default .Summary -}}
    {{- $date := "" -}}
    {{- if not .Date.IsZero -}}{{- $date = .Date.Format "2006-01-02" -}}{{- end -}}
    {{- $item := dict
      "title" .Title
      "summary" ($summary | plainify)
      "content" (.Plain | plainify | truncate 4000)
      "authors" $authors
      "tags" .Params.tags
      "categories" .Params.categories
      "projects" $projectNames
      "section" $section
      "type" .Type
      "date" $date
      "permalink" .RelPermalink
    -}}
    {{- $items = $items | append $item -}}
  {{- end -}}
{{- end -}}
{{- range hugo.Data.publications_generated -}}
  {{- $projectNames := slice -}}
  {{- with .projects -}}
    {{- range . -}}
      {{- $project := $.Site.GetPage (printf "projects/%s" .) -}}
      {{- if $project -}}
        {{- $projectNames = $projectNames | append $project.Title -}}
      {{- else -}}
        {{- $projectNames = $projectNames | append . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $permalink := .full_text | default .doi_url -}}
  {{- $item := dict
    "title" .title
    "summary" (printf "%v %s" (.year | default "") (.journal | default ""))
    "content" (delimit (slice .title (delimit .authors " ") (.journal | default "") (.journal_short | default "") (delimit $projectNames " ")) " ")
    "authors" .authors
    "tags" slice
    "categories" slice
    "projects" $projectNames
    "section" "publications"
    "type" "publication"
    "date" .date
    "permalink" $permalink
  -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $items | jsonify -}}

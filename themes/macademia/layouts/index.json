{{- $macademia := .Site.Params.macademia | default dict -}}
{{- $search := $macademia.search | default dict -}}
{{- $allowed := $search.sections | default (slice "about" "posts" "projects" "awards" "talks" "courses" "publications") -}}
{{- $projectTags := partial "macademia/project-tags.html" (dict "site" .Site) -}}
{{- $items := slice -}}
{{- $seen := dict -}}
{{- $allPages := .Site.Pages -}}
{{- range $allowed -}}
  {{- $section := . -}}
  {{- with $.Site.GetPage $section -}}
    {{- range .Pages -}}
      {{- $allPages = $allPages | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $allPages -}}
  {{- $page := . -}}
  {{- $section := .Section -}}
  {{- $filePath := "" -}}
  {{- with .File -}}{{- $filePath = .Path -}}{{- end -}}
  {{- $key := printf "%s::%s" $section ($filePath | default .Title) -}}
  {{- if and (in $allowed $section) (not .Draft) (not .Params.private) (not .Params.exclude_search) (ne .Kind "home") (not (index $seen $key)) -}}
    {{- $seen = merge $seen (dict $key true) -}}
    {{- $authors := .Params.authors -}}
    {{- if not $authors -}}
      {{- with .Params.author -}}{{- $authors = slice . -}}{{- end -}}
    {{- end -}}
    {{- $projects := slice -}}
    {{- with $page.Params.tags -}}
      {{- range . -}}
        {{- if in $projectTags . -}}
          {{- $title := partial "macademia/project-label.html" (dict "site" $.Site "tag" .) -}}
          {{- $projects = $projects | append . | append $title -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $summary := .Params.summary | default .Params.abstract | default .Summary -}}
    {{- $date := "" -}}
    {{- if not .Date.IsZero -}}{{- $date = .Date.Format "2006-01-02" -}}{{- end -}}
    {{- $content := delimit (slice .Plain .Params.journal .Params.journal_short .Params.doi (delimit $projects " ")) " " -}}
    {{- $permalink := .RelPermalink -}}
    {{- if and (eq $section "publications") (eq .Kind "page") -}}
      {{- $permalink = .Params.doi_url | default .Params.fulltext | default .Params.full_text | default .RelPermalink -}}
    {{- end -}}
    {{- $item := dict
      "title" .Title
      "summary" ($summary | plainify)
      "content" ($content | plainify | truncate 4000)
      "authors" $authors
      "tags" .Params.tags
      "categories" .Params.categories
      "projects" $projects
      "section" $section
      "type" .Type
      "date" $date
      "permalink" $permalink
    -}}
    {{- $items = $items | append $item -}}
  {{- end -}}
{{- end -}}
{{- $items | jsonify -}}
